# Install guards, read by npm 11.15 or later (pinned in package.json's packageManager).

# Choose only releases at least 7 days old when npm picks a version (npm install, npm update,
# npm audit fix). npm ci installs the lockfile as it is. For an urgent fix younger than that:
# npm install <pkg>@<version> --min-release-age=0, with the reason in the pull request.
min-release-age=7

# A git dependency or a tarball from a URL only where package.json itself names one, never one a
# dependency brings in.
allow-git=root
allow-remote=root
